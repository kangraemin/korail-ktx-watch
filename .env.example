# 코레일 회원 로그인 (필수) — 멤버십번호·이메일·휴대폰번호 중 하나
KORAIL_ID=
KORAIL_PW=

# 텔레그램 알림 (선택) — 비워 두면 터미널·맥 알림만
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 자동 결제 (선택) — --auto-pay로 실행할 때만 씀. 비워 두면 예약만 함
CARD_NUMBER=        # 카드번호 숫자만 (하이픈 있어도 됨)
CARD_PW2=           # 카드 비밀번호 앞 2자리
CARD_EXPIRE=        # 유효기간 YYMM (예: 2908 = 2029년 8월)
CARD_BIRTH=         # 개인카드: 생년월일 YYMMDD / 법인카드: 사업자등록번호 10자리
CARD_INSTALLMENT=0  # 할부 개월 (0 = 일시불)
